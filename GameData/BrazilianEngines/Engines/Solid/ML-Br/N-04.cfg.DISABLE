            {
                key = 1.000 0.92   0.0   0.0
                key = 0.985 0.97   1.8   1.8
                key = 0.950 1.00   0.6   0.6
                key = 0.850 1.02   0.1   0.1
                key = 0.700 1.01  -0.05 -0.05
                key = 0.550 1.00  -0.08 -0.08
                key = 0.400 0.98  -0.12 -0.12
