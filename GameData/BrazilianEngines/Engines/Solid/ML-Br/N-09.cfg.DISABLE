                resourceFlowMode = STACK_PRIORITY_SEARCH
            }
            atmosphereCurve
            {
                key = 0 270
                key = 1 240
            }
			curveResource = HTPB
			powerEffectName = Solid-Lower

            thrustCurve
            {
                key = 1.00 1.02
                key = 0.98 1.04
