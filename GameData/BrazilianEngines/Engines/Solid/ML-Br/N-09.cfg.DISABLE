		{
			name = N09
			maxThrust = 30
			heatProduction = 100

            IGNITOR_RESOURCE
            {
                name = ElectricCharge
                amount = 0.1
            }
            PROPELLANT
            {
                name = HTPB
                ratio = 1.0
