		{
			targetName = TVC_1_Aim
			rotatorsName = TVC_1_Rotate
		}
		CONSTRAINLOOKFX
		{
			targetName = TVC_2_Aim
			rotatorsName = TVC_2_Rotate
		}
	}

	MODULE
	{
